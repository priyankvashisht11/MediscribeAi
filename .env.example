# ─────────────────────────────────────────────────────────────────
# Chartr — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to git.
# ─────────────────────────────────────────────────────────────────

# ── Database (PostgreSQL) ─────────────────────────────────────────
# Local Docker dev — these match docker-compose.yml defaults
POSTGRES_USER=chartr
POSTGRES_PASSWORD=chartr_dev_secret
POSTGRES_DB=chartr_db
DATABASE_URL=postgresql+asyncpg://chartr:chartr_dev_secret@db:5432/chartr_db

# Production (Supabase) — replace with your Supabase connection string
# DATABASE_URL=postgresql+asyncpg://postgres.[ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# ── Redis ─────────────────────────────────────────────────────────
# Local Docker dev
REDIS_URL=redis://redis:6379/0

# Production (Upstash) — replace with your Upstash Redis URL
# REDIS_URL=rediss://default:[password]@[host].upstash.io:6379

# ── App ───────────────────────────────────────────────────────────
SECRET_KEY=change_me_in_production_use_openssl_rand_hex_32
ENVIRONMENT=development

# ── CORS ──────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Dev: just localhost. Production: your Vercel URL.
ALLOWED_ORIGINS=http://localhost:3000
# Production example:
# ALLOWED_ORIGINS=https://chartr.vercel.app,https://chartr.yourdomain.com

# ── Deepgram (real-time ASR + speaker diarization) ────────────────
# Sign up at https://console.deepgram.com — $200 free credits on signup
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# ── Perplexity (SOAP note + ICD-10 generation) ────────────────────
# Sign up at https://www.perplexity.ai/api — model: sonar-reasoning-pro
PERPLEXITY_API_KEY=your_perplexity_api_key_here

# ── OpenAI (fallback if Perplexity is unavailable) ────────────────
OPENAI_API_KEY=sk-placeholder

# ── Session limits ────────────────────────────────────────────────
MAX_CONCURRENT_SESSIONS=5
SPEAKER_ASSIGNMENT_WINDOW_SECONDS=60
