# Database
POSTGRES_USER=mediscribe
POSTGRES_PASSWORD=mediscribe_dev_secret
POSTGRES_DB=mediscribe_db
DATABASE_URL=postgresql+asyncpg://mediscribe:mediscribe_dev_secret@db:5432/mediscribe_db

# Redis
REDIS_URL=redis://redis:6379/0

# App
SECRET_KEY=change_me_in_production_use_openssl_rand_hex_32
ENVIRONMENT=development

# Deepgram ASR (real-time transcription + speaker diarization)
# Sign up at https://console.deepgram.com — $200 free credits on signup
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# LLM
OPENAI_API_KEY=sk-placeholder

# ASR
WHISPER_MODEL_SIZE=medium
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=hi
AUDIO_CHUNK_BUFFER_SECONDS=3
AUDIO_TEMP_DIR=/tmp/mediscribe_audio
MAX_CONCURRENT_SESSIONS=5

# Diarization
HF_TOKEN=your_huggingface_read_token_here
DIARIZATION_ENABLED=true
DIARIZATION_MODEL=pyannote/speaker-diarization-3.1
SPEAKER_ASSIGNMENT_WINDOW_SECONDS=60
MIN_SPEAKERS=2
MAX_SPEAKERS=2
