# Database
POSTGRES_USER=mediscribe
POSTGRES_PASSWORD=mediscribe_dev_secret
POSTGRES_DB=mediscribe_db
DATABASE_URL=postgresql+asyncpg://mediscribe:mediscribe_dev_secret@db:5432/mediscribe_db

# Redis
REDIS_URL=redis://redis:6379/0

# App
SECRET_KEY=change_me_in_production_use_openssl_rand_hex_32
ENVIRONMENT=development

# LLM (stub for POC — no real API calls until Sprint 3+)
OPENAI_API_KEY=sk-placeholder

# ASR
WHISPER_MODEL_SIZE=medium
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=hi
AUDIO_CHUNK_BUFFER_SECONDS=3
AUDIO_TEMP_DIR=/tmp/mediscribe_audio
MAX_CONCURRENT_SESSIONS=5
