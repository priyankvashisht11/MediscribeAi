<?xml version="1.0" encoding="utf-8"?>
<!-- Chartr app icon: white stethoscope on teal background -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportHeight="108"
    android:viewportWidth="108">

    <!-- Left ear channel (diagonal tube) -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:pathData="M 27,24 L 36,34" />

    <!-- Right ear channel (diagonal tube) -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:pathData="M 81,24 L 72,34" />

    <!-- Main U-arch connecting both ear channels, bottom connects to chest piece -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:pathData="M 36,34 C 22,50 22,64 54,64 C 86,64 86,50 72,34" />

    <!-- Chest piece diaphragm ring (evenOdd = annulus shape) -->
    <path
        android:fillColor="#FFFFFF"
        android:fillType="evenOdd"
        android:pathData="M 54,77 m -13,0 a 13,13 0 1,0 26,0 a 13,13 0 1,0 -26,0 M 54,77 m -7,0 a 7,7 0 1,0 14,0 a 7,7 0 1,0 -14,0" />

